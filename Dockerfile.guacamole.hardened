# ------------------------------------------------------------
# Hardened Guacamole (Tomcat + JRE + guacamole.war) runtime image
# Grafana/postgres-pattern: slim baseline -> staged artifacts -> rootfs -> strip -> scratch
#
# NOTE: catalina.sh (Tomcat's startup script) requires a POSIX shell and a
# handful of coreutils to assemble the classpath and JVM options. Unlike
# postgres's single-binary ENTRYPOINT, this cannot go fully shell-free
# without rewriting Tomcat's startup to invoke java directly and bypass
# catalina.sh -- DHI itself keeps catalina.sh for the same reason. This
# Dockerfile deliberately retains /bin/sh and the coreutils catalina.sh
# needs; everything else follows the same builder/rootfs-export/scratch
# shape as the postgres hardened image.
# ------------------------------------------------------------

FROM container-forge/debian13-slim:latest AS builder

ARG TOMCAT_VERSION=9.0.118
ARG JDK_VERSION=21.0.11.10
ARG GUAC_VERSION=1.6.0

ENV DEBIAN_FRONTEND=noninteractive
ENV JAVA_HOME=/opt/jre
ENV CATALINA_HOME=/usr/local/tomcat
ENV PATH="${PATH}:${JAVA_HOME}/bin"

# Minimal runtime packages only
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        fontconfig \
        libfreetype6 \
        libpng16-16 \
        libjpeg62-turbo \
        procps && \
        openssl \
        libssl3 \
    rm -rf /var/lib/apt/lists/*

# Remove inherited forge user (UID 1000) if present
RUN if getent passwd 1000 >/dev/null; then \
        userdel -r "$(getent passwd 1000 | cut -d: -f1)" || true; \
    fi && \
    if getent group 1000 >/dev/null; then \
        groupdel 1000 || true; \
    fi

# Create non-root tomcat user
RUN useradd -r -u 65532 -d ${CATALINA_HOME} -s /usr/sbin/nologin tomcat

# Install JRE
COPY src/openjdk/${JDK_VERSION}/OpenJDK21U-jre_x64_linux_hotspot_21.0.11_10.tar.gz /tmp/jre.tar.gz
RUN mkdir -p /opt/jre && \
    tar -xzf /tmp/jre.tar.gz --strip-components=1 -C /opt/jre && \
    rm -f /tmp/jre.tar.gz

# Install Tomcat
COPY src/tomcat/${TOMCAT_VERSION}/tomcat-${TOMCAT_VERSION}.tar.gz /tmp/tomcat.tar.gz
RUN mkdir -p /usr/local && \
    tar -xzf /tmp/tomcat.tar.gz -C /usr/local && \
    mv /usr/local/apache-tomcat-${TOMCAT_VERSION} ${CATALINA_HOME} && \
    rm -f /tmp/tomcat.tar.gz

# Guacamole deployment directories
RUN mkdir -p ${CATALINA_HOME}/.guacamole/extensions \
             ${CATALINA_HOME}/.guacamole/lib

# Ensure .guacamole exists and is owned by tomcat
RUN mkdir -p /usr/local/tomcat/.guacamole && \
    chown -R tomcat:tomcat /usr/local/tomcat/.guacamole && \
    chmod 0755 /usr/local/tomcat/.guacamole

# WAR lives in quarterly root
COPY guacamole-${GUAC_VERSION}.war ${CATALINA_HOME}/webapps/guacamole.war

# JARs live in lib/ at quarterly root
COPY lib/*.jar ${CATALINA_HOME}/.guacamole/lib/
# Optional extensions:
# COPY extensions/*.jar ${CATALINA_HOME}/.guacamole/extensions/

# guacamole.properties
COPY 1.6.0/guacamole.properties /usr/local/tomcat/.guacamole/
RUN chown tomcat:tomcat /usr/local/tomcat/.guacamole/guacamole.properties && \
    chmod 0644 /usr/local/tomcat/.guacamole/guacamole.properties

# SELinux-safe writable directories
RUN mkdir -p \
      ${CATALINA_HOME}/temp \
      ${CATALINA_HOME}/logs \
      ${CATALINA_HOME}/work \
      /var/lib/tomcat \
      /output && \
    chown -R tomcat:tomcat \
      ${CATALINA_HOME} \
      /var/lib/tomcat \
      /output

# Build rootfs BEFORE stripping (Grafana/postgres pattern)
RUN mkdir /rootfs && \
    cp -a /bin /rootfs/bin && \
    cp -a /lib /rootfs/lib && \
    cp -a /lib64 /rootfs/lib64 && \
    cp -a /usr /rootfs/usr && \
    cp -a /etc /rootfs/etc && \
    cp -a /var /rootfs/var && \
    cp -a /opt /rootfs/opt

# Strip inside rootfs -- hardening only. Same removal list as before;
# deliberately does NOT touch /bin/sh, awk-free coreutils, or anything
# catalina.sh needs to assemble the classpath and start the JVM.
RUN rm -f /rootfs/usr/bin/apt /rootfs/usr/bin/apt-get /rootfs/usr/bin/apt-cache /rootfs/usr/bin/dpkg && \
    rm -f /rootfs/usr/bin/curl /rootfs/usr/bin/wget /rootfs/usr/bin/ftp || true && \
    rm -f /rootfs/usr/bin/python* /rootfs/usr/bin/perl || true && \
    rm -f /rootfs/usr/bin/strace /rootfs/usr/bin/lsof /rootfs/usr/bin/nc /rootfs/usr/bin/telnet || true && \
    rm -f /rootfs/usr/bin/vi /rootfs/usr/bin/nano /rootfs/usr/bin/less || true && \
    rm -f /rootfs/usr/bin/awk /rootfs/usr/bin/sed /rootfs/usr/bin/grep || true && \
    rm -f /rootfs/usr/bin/chage /rootfs/usr/bin/chfn /rootfs/usr/bin/chsh /rootfs/usr/bin/passwd /rootfs/usr/bin/newgrp /rootfs/usr/bin/gpasswd || true && \
    rm -f /rootfs/bin/bash || true && \
    rm -rf /rootfs/var/lib/apt /rootfs/var/cache/apt /rootfs/var/lib/dpkg || true && \
    rm -rf /rootfs/usr/share/man /rootfs/usr/share/doc || true && \
    rm -f /rootfs/usr/sbin/useradd /rootfs/usr/sbin/groupadd /rootfs/usr/sbin/adduser /rootfs/usr/sbin/addgroup || true

FROM scratch

ARG TOMCAT_VERSION=9.0.118
ARG JDK_VERSION=21.0.11.10
ARG GUAC_VERSION=1.6.0

LABEL org.opencontainers.image.title="guacamole-hardened" \
      org.opencontainers.image.version="${GUAC_VERSION}" \
      org.opencontainers.image.description="Hardened Guacamole (Tomcat ${TOMCAT_VERSION} + JRE ${JDK_VERSION}) runtime image" \
      org.opencontainers.image.licenses="Apache-2.0"

ENV JAVA_HOME=/opt/jre
ENV CATALINA_HOME=/usr/local/tomcat
ENV PATH="${PATH}:${JAVA_HOME}/bin"

COPY --from=builder /rootfs/ /

USER tomcat
WORKDIR ${CATALINA_HOME}

EXPOSE 8080

CMD ["bin/catalina.sh", "run"]
